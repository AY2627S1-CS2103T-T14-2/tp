@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

note over LogicManager, Model
    Successful delete of an existing supporter.
    Error paths and Model internals are omitted.
end note

LogicManager -> AddressBookParser : parseCommand("delete 1")
activate AddressBookParser

create DeleteCommandParser
AddressBookParser -> DeleteCommandParser : DeleteCommandParser()
activate DeleteCommandParser
DeleteCommandParser --> AddressBookParser
deactivate DeleteCommandParser

AddressBookParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser

create DeleteCommand
DeleteCommandParser -> DeleteCommand : DeleteCommand(index)
activate DeleteCommand
DeleteCommand --> DeleteCommandParser
deactivate DeleteCommand

DeleteCommandParser --> AddressBookParser : d
deactivate DeleteCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getFilteredPersonList()
activate Model
Model --> DeleteCommand : lastShownList
deactivate Model

note over DeleteCommand
    Validate the index, select personToDelete,
    and count their interactions.
end note

DeleteCommand -> Model : deletePerson(personToDelete)
activate Model
Model --> DeleteCommand
deactivate Model

DeleteCommand -> Model : replaceIntroducer(personToDelete.getName(), Optional.empty())
activate Model
Model --> DeleteCommand : clearedIntroductions
deactivate Model

create CommandResult
DeleteCommand -> CommandResult : CommandResult(message)
activate CommandResult
CommandResult --> DeleteCommand
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

LogicManager -> Model : commitAddressBookIfChanged()
activate Model
Model --> LogicManager
deactivate Model

note right of LogicManager
    Before returning, LogicManager saves
    model.getAddressBook() through Storage.
    Persistence interactions are omitted.
end note

[<-- LogicManager : r
deactivate LogicManager

@enduml
